{
    "title": "Custom keyboard key mapping",
    "rules": [
        {
            "description": "Change left_command+escape to left_command+grave_accent_and_tilde",
            "manipulators": [
                {
                    "type": "basic",
                    "from": {
                        "key_code": "escape",
                        "modifiers": {
                            "mandatory": [
                                "left_command"
                            ],
                            "optional": []
                        }
                    },
                    "to": [
                        {
                            "key_code": "grave_accent_and_tilde",
                            "modifiers": [
                                "left_command"
                            ]
                        }
                    ]
                }
            ]
        }
    ]
}
